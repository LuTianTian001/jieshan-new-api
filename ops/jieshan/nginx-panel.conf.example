# Installed inside nginx's http context. Replace panel.example.com and, if
# necessary, the loopback port. Enable only after obtaining the certificate.
map $http_upgrade $jieshan_relay_connection {
    default upgrade;
    ''      '';
}

upstream jieshan_relay_app {
    server 127.0.0.1:13000;
    keepalive 16;
}

# Avoid storing authorization headers, paths, query strings or request bodies.
log_format jieshan_relay_min '$time_iso8601 $request_method $status $request_time';

server {
    listen 80;
    listen [::]:80;
    server_name panel.example.com;
    access_log off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 https://panel.example.com$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name panel.example.com;
    ssl_certificate /etc/letsencrypt/live/panel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=2592000" always;
    access_log /var/log/nginx/jieshan-relay-access.log jieshan_relay_min;

    client_max_body_size 128m;
    location / {
        proxy_pass http://jieshan_relay_app;
        proxy_http_version 1.1;
        proxy_set_header Host panel.example.com;
        proxy_set_header X-Forwarded-Host panel.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        # This host is the public edge; replace any client-supplied chain.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $jieshan_relay_connection;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        send_timeout 900s;
    }
}
